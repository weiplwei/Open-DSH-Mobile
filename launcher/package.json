{
  "name": "@local/open-dsh-mobile-metro",
  "version": "1.0.0",
  "private": true,
  "description": "Starts Open DSH Mobile Metro with DSH and stops it when DSH exits.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
